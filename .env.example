# Medical Centre Application Environment Configuration
# Copy this file to .env and update values as needed

# Spring Boot Version: 4.2.0
# Spring Cloud Version: 2025.0.0
# Java Version: 25
# JaCoCo Version: 0.8.14 (Java 25 support)
# Test Coverage Threshold: 80% (Instruction, Branch, Complexity, Line, Method, Class)

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# MongoDB
MONGODB_URI=mongodb://admin:password@mongodb:27017/medical-centre?authSource=admin

# Keycloak / Identity
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080/auth
KEYCLOAK_REALM=medical-centre
KEYCLOAK_CLIENT_ID=medical-centre-app

# Services
PATIENTS_SERVICE_URL=http://localhost:8080
MEDICS_SERVICE_URL=http://localhost:8082
APPOINTMENTS_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8083
IDENTITY_SERVICE_URL=http://localhost:8084

# Email / SMTP
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Application
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms512m -Xmx1g